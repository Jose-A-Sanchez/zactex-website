/* ============================================
   ZAC-TEX Construction & Roofing — Design Tokens
   ============================================ */
:root {
  /* Color */
  --navy: #123C51;
  --blue: #006CA3;
  --blue-light: #2E8FC2;
  --orange: #EB6B27;
  --orange-dark: #CC541A;
  --warm-white: #F7F5F1;
  --steel: #5B6B74;
  --charcoal: #1A1F23;
  --white: #FFFFFF;

  /* Type */
  --font-display: 'Archivo', sans-serif;
  --font-body: 'Inter', sans-serif;

  /* Layout */
  --max-width: 1180px;
  --radius: 6px;
  --section-pad: clamp(64px, 9vw, 120px);
}

/* ---------- Reset ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--charcoal);
  background: var(--warm-white);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, h4 { font-family: var(--font-display); margin: 0; line-height: 1.08; color: var(--navy); }
p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
button { font-family: inherit; cursor: pointer; }

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 24px;
}

.eyebrow {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--orange);
  display: inline-block;
  margin-bottom: 14px;
}

/* Visible keyboard focus */
a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 2px;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  padding: 15px 28px;
  border-radius: var(--radius);
  border: 2px solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--orange); color: var(--white); }
.btn-primary:hover { background: var(--orange-dark); }
.btn-outline { background: transparent; color: var(--white); border-color: rgba(255,255,255,0.55); }
.btn-outline:hover { border-color: var(--white); }
.btn-outline-navy { background: transparent; color: var(--navy); border-color: var(--navy); }
.btn-outline-navy:hover { background: var(--navy); color: var(--white); }

/* ============================================
   Header / Nav
   ============================================ */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--warm-white);
  border-bottom: 1px solid rgba(18,60,81,0.1);
}
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 24px;
}
.nav-logo { display: flex; align-items: center; gap: 10px; }
.nav-logo img { height: 72px; width: auto; }

@media (max-width: 860px) {
  .nav-logo img { height: 56px; }
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 32px;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.92rem;
}
.nav-links a { color: var(--navy); }
.nav-links a:hover { color: var(--blue); }
.nav-cta { display: flex; align-items: center; gap: 18px; }
.nav-phone {
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--navy);
  font-size: 1rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.nav-phone svg { flex-shrink: 0; }
.nav-toggle {
  display: none;
  background: none;
  border: none;
  padding: 8px;
}
.nav-toggle svg { width: 26px; height: 26px; }

@media (max-width: 860px) {
  .nav-links { display: none; }
  .nav-toggle { display: block; }
  .nav-cta .btn-primary span.long { display: none; }
}

/* ============================================
   Hero
   ============================================ */
.hero {
  position: relative;
  background: linear-gradient(160deg, var(--navy) 0%, #0C2836 100%);
  overflow: hidden;
  padding: 90px 0 0;
}
.hero-inner {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}
.hero-copy .eyebrow { color: var(--orange); }
.hero h1 {
  color: var(--white);
  font-size: clamp(2.4rem, 4.6vw, 3.6rem);
  font-weight: 800;
  letter-spacing: -0.01em;
}
.hero h1 em {
  font-style: normal;
  color: var(--orange);
}
.hero-sub {
  color: rgba(255,255,255,0.78);
  font-size: 1.15rem;
  max-width: 46ch;
  margin-top: 20px;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 34px;
}
.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 26px;
  margin-top: 48px;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.15);
}
.hero-trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(255,255,255,0.85);
  font-size: 0.88rem;
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.hero-trust-item svg { color: var(--orange); flex-shrink: 0; }

.hero-visual { position: relative; height: 100%; min-height: 320px; }
.hero-visual svg { width: 100%; height: auto; }

/* Blueprint roofline motif — draws itself in, then idles with a gentle float */
.roof-motif .draw-path {
  stroke-dasharray: 900;
  stroke-dashoffset: 900;
  animation: drawLine 1.6s ease-out forwards, floatY 6s ease-in-out 1.8s infinite;
}
.roof-motif .draw-path.delay-1 { animation-delay: 0.15s, 1.95s; }
.roof-motif .draw-path.delay-2 { animation-delay: 0.4s, 2.2s; }
.roof-motif .apex-dot {
  opacity: 0;
  animation: fadeInDot 0.6s ease-out 1.7s forwards, pulseGlow 2.6s ease-in-out 2.4s infinite;
}
.roof-motif .grid-dot { opacity: 0.35; }

@keyframes drawLine {
  to { stroke-dashoffset: 0; }
}
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-9px); }
}
@keyframes fadeInDot {
  to { opacity: 1; }
}
@keyframes pulseGlow {
  0%, 100% { opacity: 0.55; r: 5; }
  50% { opacity: 1; r: 8; }
}

@media (prefers-reduced-motion: reduce) {
  .roof-motif .draw-path {
    stroke-dashoffset: 0;
    animation: none;
  }
  .roof-motif .apex-dot {
    opacity: 1;
    animation: none;
  }
}

.roofline-divider {
  display: block;
  width: 100%;
  line-height: 0;
  margin-top: 60px;
}
.roofline-divider svg { width: 100%; height: auto; display: block; }

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-visual { min-height: 0; order: -1; opacity: 0.5; }
}

/* ============================================
   Trust bar
   ============================================ */
.trust-bar {
  background: var(--white);
  border-bottom: 1px solid rgba(18,60,81,0.08);
}
.trust-bar .container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20px;
  padding-top: 26px;
  padding-bottom: 26px;
}
.trust-bar-item {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.03em;
  color: var(--steel);
  display: flex;
  align-items: center;
  gap: 10px;
  text-transform: uppercase;
}
.trust-bar-item svg { color: var(--blue); flex-shrink: 0; }

/* ============================================
   Section shared
   ============================================ */
.section { padding: var(--section-pad) 0; }
.section-head {
  max-width: 640px;
  margin-bottom: 52px;
}
.section-head h2 {
  font-size: clamp(1.9rem, 3.4vw, 2.6rem);
}
.section-head p {
  color: var(--steel);
  font-size: 1.05rem;
  margin-top: 16px;
}
.section-navy { background: var(--navy); }
.section-navy .section-head h2 { color: var(--white); }
.section-navy .section-head p { color: rgba(255,255,255,0.72); }
.section-navy .eyebrow { color: var(--orange); }

/* ============================================
   Services grid
   ============================================ */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.service-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 32px 28px;
  border: 1px solid rgba(18,60,81,0.08);
  border-top: 3px solid var(--blue);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px rgba(18,60,81,0.12);
}
.service-card .icon {
  width: 46px;
  height: 46px;
  color: var(--orange);
  margin-bottom: 18px;
}
.service-card h3 {
  font-size: 1.2rem;
  margin-bottom: 10px;
}
.service-card p {
  color: var(--steel);
  font-size: 0.96rem;
}
.service-card.placeholder {
  border-top-color: var(--orange);
  border-style: dashed;
  border-color: rgba(235,107,39,0.4);
  background: rgba(235,107,39,0.04);
}
.service-card.placeholder h3 { color: var(--orange-dark); }

@media (max-width: 900px) {
  .services-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .services-grid { grid-template-columns: 1fr; }
}

/* ============================================
   About / Why us
   ============================================ */
.about-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 60px;
  align-items: center;
}
.about-figure {
  background: var(--blue);
  border-radius: var(--radius);
  aspect-ratio: 4/5;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 28px;
}
.about-figure::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(200deg, var(--blue-light) 0%, var(--navy) 100%);
}
.about-figure-content {
  position: relative;
  color: var(--white);
}
.about-figure-content .name {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.3rem;
}
.about-figure-content .role {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.75);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 4px;
}
.about-list { margin-top: 28px; display: grid; gap: 18px; }
.about-list li {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  color: var(--charcoal);
}
.about-list svg { color: var(--orange); flex-shrink: 0; margin-top: 3px; }
.about-list strong { font-family: var(--font-display); }

@media (max-width: 860px) {
  .about-grid { grid-template-columns: 1fr; }
}

/* ============================================
   Service area
   ============================================ */
.area-panel {
  background: var(--white);
  border: 1px dashed rgba(235,107,39,0.5);
  border-radius: var(--radius);
  padding: 40px;
  text-align: center;
}
.area-panel .eyebrow { color: var(--orange-dark); }
.area-panel p { color: var(--steel); max-width: 60ch; margin: 12px auto 0; }

/* ============================================
   CTA / Contact
   ============================================ */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}
.contact-info { color: rgba(255,255,255,0.85); }
.contact-info h2 { color: var(--white); }
.contact-info p.lead { margin-top: 16px; font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 44ch; }
.contact-detail {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin-top: 26px;
}
.contact-detail svg { color: var(--orange); flex-shrink: 0; margin-top: 3px; }
.contact-detail .label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.55); }
.contact-detail .value { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--white); }

.contact-form {
  background: var(--white);
  border-radius: var(--radius);
  padding: 36px;
}
.form-row { display: grid; gap: 8px; margin-bottom: 18px; }
.form-row label {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--navy);
}
.form-row input, .form-row select, .form-row textarea {
  font-family: var(--font-body);
  font-size: 0.98rem;
  padding: 13px 14px;
  border: 1px solid rgba(18,60,81,0.2);
  border-radius: 4px;
  background: var(--warm-white);
  color: var(--charcoal);
  width: 100%;
}
.form-row textarea { resize: vertical; min-height: 100px; }
.form-two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.form-note { font-size: 0.8rem; color: var(--steel); margin-top: 10px; }

@media (max-width: 860px) {
  .contact-grid { grid-template-columns: 1fr; }
  .form-two { grid-template-columns: 1fr; }
}

/* ============================================
   Interior page header (About / Service Area / Contact)
   ============================================ */
.page-header {
  background: linear-gradient(160deg, var(--navy) 0%, #0C2836 100%);
  padding: 64px 0 56px;
  position: relative;
}
.page-header .eyebrow { color: var(--orange); }
.page-header h1 {
  color: var(--white);
  font-size: clamp(2rem, 4vw, 2.8rem);
}
.page-header p {
  color: rgba(255,255,255,0.75);
  font-size: 1.05rem;
  max-width: 56ch;
  margin-top: 14px;
}
.page-header .roofline-divider { margin-top: 44px; }

/* ============================================
   CTA banner (used at the bottom of interior pages)
   ============================================ */
.cta-banner {
  background: var(--orange);
  padding: 52px 0;
}
.cta-banner .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24px;
}
.cta-banner h2 {
  color: var(--white);
  font-size: clamp(1.5rem, 3vw, 2rem);
}
.cta-banner p {
  color: rgba(255,255,255,0.9);
  margin-top: 6px;
}
.cta-banner .btn-primary {
  background: var(--navy);
}
.cta-banner .btn-primary:hover {
  background: #0C2836;
}

/* ============================================
   Service area city cards
   ============================================ */
.area-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.area-card {
  background: var(--white);
  border: 1px solid rgba(18,60,81,0.08);
  border-top: 3px solid var(--orange);
  border-radius: var(--radius);
  padding: 32px;
}
.area-card h3 {
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 10px;
}
.area-card h3 svg { color: var(--orange); flex-shrink: 0; }
.area-card p {
  color: var(--steel);
  margin-top: 12px;
}
.area-card ul {
  margin-top: 16px;
  display: grid;
  gap: 8px;
}
.area-card ul li {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--charcoal);
  font-size: 0.95rem;
}
.area-card ul li svg { color: var(--blue); flex-shrink: 0; }
.area-note {
  margin-top: 28px;
  background: rgba(235,107,39,0.06);
  border: 1px dashed rgba(235,107,39,0.4);
  border-radius: var(--radius);
  padding: 20px 24px;
  color: var(--steel);
  font-size: 0.95rem;
}

@media (max-width: 700px) {
  .area-grid { grid-template-columns: 1fr; }
}

/* ============================================
   Footer
   ============================================ */
.site-footer {
  background: #0C2836;
  color: rgba(255,255,255,0.6);
  padding: 50px 0 28px;
}
.footer-top {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 32px;
  padding-bottom: 34px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.footer-logo img { height: 38px; margin-bottom: 14px; }
.footer-logo p { max-width: 32ch; font-size: 0.9rem; }
.footer-cols { display: flex; gap: 60px; flex-wrap: wrap; }
.footer-col h4 {
  color: var(--white);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 16px;
}
.footer-col ul { display: grid; gap: 10px; font-size: 0.92rem; }
.footer-col a:hover { color: var(--white); }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding-top: 24px;
  font-size: 0.82rem;
}

/* ============================================
   Mobile nav drawer
   ============================================ */
.mobile-nav {
  position: fixed;
  inset: 0;
  background: var(--navy);
  z-index: 200;
  display: flex;
  flex-direction: column;
  padding: 24px;
  transform: translateX(100%);
  transition: transform 0.25s ease;
}
.mobile-nav.open { transform: translateX(0); }
.mobile-nav-top { display: flex; justify-content: flex-end; }
.mobile-nav-close { background: none; border: none; color: var(--white); padding: 8px; }
.mobile-nav-close svg { width: 26px; height: 26px; }
.mobile-nav-links { margin-top: 40px; display: grid; gap: 26px; }
.mobile-nav-links a {
  color: var(--white);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.5rem;
}
.mobile-nav-cta { margin-top: auto; display: grid; gap: 14px; }
